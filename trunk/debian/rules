#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildflags.mk

# No --optimization: it tunes for the build machine's CPU, and the packages
# must run on other machines.
WAF_OPTS = --prefix=/usr --no-faust --includeresampler --includeconvolver \
	--no-ldconfig --no-desktop-update --no-font-cache-update
ifeq (,$(filter amd64 i386,$(DEB_HOST_ARCH)))
WAF_OPTS += --disable-sse
endif

%:
	dh $@

override_dh_auto_configure:
	./waf configure $(WAF_OPTS) \
		--cxxflags="-Wall -DGSEAL_ENABLE $(CPPFLAGS) $(CXXFLAGS)" \
		--ldflags="$(LDFLAGS)"

override_dh_auto_build:
	./waf build

override_dh_auto_install:
	./waf install --destdir=$(CURDIR)/debian/guitarix-kleag

override_dh_auto_clean:
	./waf distclean || true

override_dh_auto_test:
